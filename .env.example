# Red objetivo. Empezar siempre en testnet.
HEDERA_NETWORK=hedera:testnet

# Cuenta y llave del RESOURCE SERVER (quien cobra, payTo).
# Crear/fondear en https://portal.hedera.com/ (testnet).
HEDERA_PAYTO_ACCOUNT_ID=0.0.xxxxx

# Facilitador. Blocky402 es el facilitador de referencia citado por
# Hedera para el esquema "exact" -- ver investigacion/x402-on-hedera.md.
# Confirmar URL real del facilitador antes de usar en produccion, no
# esta verificada en este scaffold.
X402_FACILITATOR_URL=https://blocky402.com

PORT=3402

# --- Parte 2: demo del esquema upto (usage-based, ver
# investigacion/upto-scheme-evaluacion.md) ---
UPTO_PROXY_CONTRACT_ID=0.0.9556979
UPTO_ASSET_ID=0.0.429274
UPTO_ASSET_DECIMALS=6
UPTO_SERVER_URL=http://localhost:3403
UPTO_FACILITATOR_URL=http://localhost:3404

# Cuenta cliente, ECDSA con alias EVM (obligatorio para upto -- ver
# scheme_upto_hedera.md prerequisito 1). Generar con
# PrivateKey.generateECDSA() de @hiero-ledger/sdk, fondear el EVM
# address resultante en https://portal.hedera.com/faucet (sin login),
# y correr `npm run setup:upto-client` para finalizar la cuenta,
# asociar el asset y aprobar el allowance al proxy.
UPTO_CLIENT_PRIVATE_KEY=
UPTO_CLIENT_EVM=
UPTO_CLIENT_ACCOUNT_ID=

# Cuenta facilitador, mismo tipo de cuenta. Paga el fee de red de cada
# capture() -- solo necesita HBAR de testnet, no el asset ni allowance.
UPTO_FACILITATOR_PRIVATE_KEY=
UPTO_FACILITATOR_EVM=
UPTO_FACILITATOR_ACCOUNT_ID=
