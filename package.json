{
  "name": "hedera-x402-service",
  "version": "0.0.1",
  "private": true,
  "description": "x402-gated service on Hedera (exact scheme), scaffold stage",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev:upto-server": "tsx watch src/upto-server.ts",
    "dev:upto-facilitator": "tsx watch src/upto-facilitator.ts",
